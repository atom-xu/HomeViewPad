    },
    "The selected photo fills the screen and may be cropped. A copy stays on this iPad, separately from your photo page. It does not follow system wallpaper changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected photo fills the screen and may be cropped. A copy stays on this iPad, separately from your photo page. It does not follow system wallpaper changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选照片会铺满屏幕，边缘可能裁切。副本保存在这台 iPad 上，与照片页分开，不随系统壁纸自动变化。"
          }
        }
      }
    },
