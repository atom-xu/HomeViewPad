          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按组件可显示导航、切换分类内容、调整大小或移除。左右滑动切换页面，组件超出时可上下滚动。旁白也提供相同操作。"
          }
