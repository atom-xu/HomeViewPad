    "Use the grid button for navigation. Swipe left or right to change pages, and scroll vertically through controls. Tap the cycle icon for the next category item. Touch and hold a widget to resize or remove it. VoiceOver offers the same actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the grid button for navigation. Swipe left or right to change pages, and scroll vertically through controls. Tap the cycle icon for the next category item. Touch and hold a widget to resize or remove it. VoiceOver offers the same actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点网格按钮显示导航，左右滑动切换页面，上下滚动查看更多控制。轻点轮换按钮切换同类内容，长按组件可调整大小或移除；旁白也提供相应操作。"
          }
        }
      }
    },
    "Use the same Apple Account and turn on iCloud Photos on both devices. Photos synced to this iPad can then be selected here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same Apple Account and turn on iCloud Photos on both devices. Photos synced to this iPad can then be selected here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备使用同一 Apple 账号并开启 iCloud 照片，照片同步到这台 iPad 后即可选择。"
          }
        }
      }
    },
    "Use this photo": {
      "localizations": {
        "en": {
          "stringUnit": {
