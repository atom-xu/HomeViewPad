    },
    "A little closer to home.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little closer to home."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让家，触手可及。"
