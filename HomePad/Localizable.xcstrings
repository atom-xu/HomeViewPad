      }
    },
    "The current page dims after this time. The first touch restores brightness without activating a control. Music can keep playing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current page dims after this time. The first touch restores brightness without activating a control. Music can keep playing."
