    },
    "A single photo is copied into HomePad. Choosing an album below displays photos from your library without copying the album. Anyone looking at this iPad can see them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single photo is copied into HomePad. Choosing an album below displays photos from your library without copying the album. Anyone looking at this iPad can see them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单张照片会复制到 HomePad 中。选择相册时仅展示图库照片，不复制整个相册。经过这台 iPad 的人都可能看到展示内容。"
          }
        }
      }
    },
