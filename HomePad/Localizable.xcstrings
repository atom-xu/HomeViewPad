    "Keep this app open. When the iPad is nearly vertical, stationary and untouched for the selected time, it shows a dim standby clock. Automatic standby keeps the supported iPad display awake in the foreground.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this app open. When the iPad is nearly vertical, stationary and untouched for the selected time, it shows a dim standby clock. Automatic standby keeps the supported iPad display awake in the foreground."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持应用打开。iPad 接近竖直、静止且无人操作达到设定时间后，会进入低亮度待机时钟。支持姿态感知的 iPad 会在应用前台保持常亮。"
          }
        }
      }
    },
    "Keep this page visible, dim when idle, and touch once to restore brightness.": {
