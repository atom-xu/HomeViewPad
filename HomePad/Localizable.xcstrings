          }
        }
      }
    },
    "The front camera detects a face without identifying anyone. No images are saved or sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front camera detects a face without identifying anyone. No images are saved or sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过前置相机判断是否出现人脸，不识别身份，不保存或传送图像。"
