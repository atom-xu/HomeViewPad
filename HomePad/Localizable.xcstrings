    },
    "1. In iPad Settings → Accessibility → Guided Access, turn it on and set an exit passcode.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. In iPad Settings → Accessibility → Guided Access, turn it on and set an exit passcode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在 iPad「设置 → 辅助功能 → 引导式访问」中开启，并设置退出密码。"
          }
        }
      }
    },
    "10 µm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 µm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 微米"
          }
        }
      }
    },
    "10:09 demo time": {
      "localizations": {
        "en": {
          "stringUnit": {
