            "value": "使用这张照片"
          }
        }
      }
    },
    "Uses Apple Home access to view a compatible camera. This is separate from using this iPad's front camera to wake the standby screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple Home access to view a compatible camera. This is separate from using this iPad's front camera to wake the standby screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过家庭权限查看兼容摄像机，与使用 iPad 前置相机唤醒待机画面是两件事。"
          }
        }
      }
    },
    "Uses the Auto-Lock time in iPad Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
