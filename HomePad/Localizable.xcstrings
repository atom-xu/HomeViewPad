    },
    "Weather refreshes every 15 minutes while visible, using your saved city. City searches and its coordinates are sent to Open-Meteo. Locate once uses Apple Location Services only after you tap it; located coordinates are rounded to about 1 km. No background location tracking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather refreshes every 15 minutes while visible, using your saved city. City searches and its coordinates are sent to Open-Meteo. Locate once uses Apple Location Services only after you tap it; located coordinates are rounded to about 1 km. No background location tracking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天气页面显示时，每 15 分钟按已保存的城市更新天气。城市搜索词和所选城市的坐标会发送给 Open-Meteo。只有点击“定位一次”才会使用 Apple 定位服务；定位坐标会取整到约 1 公里精度。不在后台持续定位。"
          }
        }
      }
    },
    "Weather time: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather time: %@"
