      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "17:30 · Water the plants"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "17:30 · 给植物浇水"
          }
