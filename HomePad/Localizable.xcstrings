    "2 minutes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 minutes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分钟"
          }
        }
      }
    },
    "2. Reopen HomePad, triple-click the top or Home button, then Start. Keep Touch and Motion enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Reopen HomePad, triple-click the top or Home button, then Start. Keep Touch and Motion enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 返回 HomePad，连按三次顶部按钮或主屏幕按钮，点「开始」。保留触摸和动作功能。"
          }
        }
      }
    },
    "2.5 µm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2.5 µm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2.5 微米"
          }
        }
      }
    },
    "270°": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "270°"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "270°"
          }
        }
      }
    },
    "3. For continuous display, optionally set Guided Access → Display Auto-Lock to Never. Triple-click again and authenticate to exit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. For continuous display, optionally set Guided Access → Display Auto-Lock to Never. Triple-click again and authenticate to exit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 如需持续展示，可将引导式访问的「显示自动锁定」设为「永不」。再次连按三次并验证后退出。"
          }
        }
      }
    },
    "30 seconds": {
      "localizations": {
        "en": {
          "stringUnit": {
