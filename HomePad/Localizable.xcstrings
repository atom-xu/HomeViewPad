    "A chosen city does not need location access. To set it from your location once, open Weather and choose Locate once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chosen city does not need location access. To set it from your location once, open Weather and choose Locate once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动选择城市无需定位权限。如需获取当前城市，请打开天气并点击“定位一次”。"
          }
        }
      }
    },
    "A face comes into view": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A face comes into view"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人面向屏幕时"
          }
        }
